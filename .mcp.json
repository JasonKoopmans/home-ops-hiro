{
  "mcpServers": {
    "kubernetes": {
      "type": "http",
      "url": "https://mcp-kubernetes.koopmans.co/mcp"
    },
    "postgres": {
      "type": "sse",
      "url": "https://mcp-postgres.koopmans.co/sse"
    },
    "prometheus": {
      "type": "http",
      "url": "https://mcp-prometheus.koopmans.co/mcp"
    },
    "grafana-monitoring": {
      "type": "http",
      "url": "https://mcp-grafana-monitoring.koopmans.co/mcp"
    },
    "grafana-lifeos": {
      "type": "http",
      "url": "https://mcp-grafana-lifeos.koopmans.co/mcp",
      "headers": {
        "Authorization": "Bearer ${MCP_GRAFANA_LIFEOS_TOKEN}"
      }
    },
    "n8n": {
      "type": "http",
      "url": "https://mcp-n8n.koopmans.co/mcp",
      "headers": {
        "Authorization": "Bearer ${MCP_N8N_TOKEN}"
      }
    },
    "playwright": {
      "type": "http",
      "url": "https://mcp-playwright.koopmans.co/mcp"
    },
    "proxmox": {
      "type": "http",
      "url": "https://mcp-proxmox.koopmans.co/mcp",
      "headers": {
        "Authorization": "Bearer ${MCP_PROXMOX_TOKEN}"
      }
    },
    "obsidian": {
      "type": "http",
      "url": "https://obsidian-mcp.koopmans.co/mcp",
      "headers": {
        "Authorization": "Bearer ${MCP_OBSIDIAN_TOKEN}"
      }
    }
  }
}
