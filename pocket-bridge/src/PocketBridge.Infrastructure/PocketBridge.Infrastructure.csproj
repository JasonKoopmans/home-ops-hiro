<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Wire DTOs are instantiated by the JSON deserializer, not by us, and need mutable
      collection properties to bind. These three rules all fire on that shape and have
      no better alternative for deserialization targets.
    -->
    <NoWarn>$(NoWarn);CA1812;CA2227;CA1819</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PocketBridge.Core\PocketBridge.Core.csproj" />
  </ItemGroup>

</Project>
