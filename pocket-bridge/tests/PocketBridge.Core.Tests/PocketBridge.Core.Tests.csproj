<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!--
      Test naming is intentionally descriptive rather than API-shaped, and tests do not
      need ConfigureAwait or sealed-type micro-optimisation.
    -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1861;CA1515;CA1852</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PocketBridge.Core\PocketBridge.Core.csproj" />
    <ProjectReference Include="..\..\src\PocketBridge.Infrastructure\PocketBridge.Infrastructure.csproj" />
  </ItemGroup>

</Project>
