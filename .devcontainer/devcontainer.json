// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/alpine
{
	"name": "Mise",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "jdxcode/mise:2026.9.14",


	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	// groff-base: `aws help` renders man pages and errors with "Could not find executable named groff or mandoc" without it.
	"postCreateCommand": "apt-get update && apt-get install -y --no-install-recommends groff-base && rm -rf /var/lib/apt/lists/* && mise trust && mise install",

	// Extensions VS Code installs into the container automatically on create/rebuild.
	// Keep in step with .vscode/extensions.json (recommendations only prompt, they don't install).
	"customizations": {
		"vscode": {
			"extensions": [
				"anthropic.claude-code",
				"blueglassblock.better-json5",
				"github.vscode-github-actions",
				"github.vscode-pull-request-github",
				"hverlin.mise-vscode",
				"irongeek.vscode-env",
				"ms-kubernetes-tools.vscode-kubernetes-tools",
				"redhat.vscode-yaml",
				"shipitsmarter.sops-edit",
				"signageos.signageos-vscode-sops",
				"task.vscode-task"
			]
		}
	},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	"remoteUser": "root",

	"mounts": [
		"source=aws-cli-config,target=/root/.aws,type=volume",
		// Survives rebuilds, so extensions installed by hand aren't lost either.
		"source=vscode-server-extensions,target=/root/.vscode-server/extensions,type=volume"
	],

	"containerEnv": {
		// The image has no `less`; the default aws pager fails with "Unable to redirect output to pager".
		"AWS_PAGER": ""
	},

	"remoteEnv": {
		"GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}",
		"MCP_GRAFANA_LIFEOS_TOKEN": "${localEnv:MCP_GRAFANA_LIFEOS_TOKEN}",
		"MCP_PROXMOX_TOKEN": "${localEnv:MCP_PROXMOX_TOKEN}"
	}
}
