# Talos 1.14 generates a ResolverConfig (host DNS) by default and rejects
# .machine.network.nameservers / .disableSearchDomain alongside it, so the
# resolver settings live here. hostDNS keeps its generated defaults.
---
apiVersion: v1alpha1
kind: ResolverConfig
nameservers:
  #% for item in node_dns_servers %#
  - address: #{ item }#
  #% endfor %#
searchDomains:
  disableDefault: true
