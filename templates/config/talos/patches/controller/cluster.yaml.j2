cluster:
  allowSchedulingOnControlPlanes: true
  coreDNS:
    disabled: true
  etcd:
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381
    advertisedSubnets:
      - #{ node_cidr }#
# Talos 1.14 moved the control-plane components out of the v1alpha1 `cluster:`
# block into their own documents, and refuses a config that sets both
# (".cluster.apiServer is already set in v1alpha1 config"). The blocks below
# are the same settings this file carried for apiServer, controllerManager,
# scheduler and proxy before the 1.14 upgrade. allowSchedulingOnControlPlanes,
# coreDNS and etcd are still v1alpha1: talhelper 3.1.17 does not generate a
# conflicting document for them, so they keep working unchanged.
---
apiVersion: v1alpha1
kind: KubeAPIServerConfig
# talhelper maps talconfig's additionalApiServerCertSans onto the v1alpha1
# cluster.apiServer.certSANs, which is no longer rendered at the 1.14 contract,
# so the SANs are stated here. The cluster API address is the control-plane VIP.
certExtraSANs:
  - "127.0.0.1"
  - "#{ cluster_api_addr }#"
  #% for item in cluster_api_tls_sans %#
  - "#{ item }#"
  #% endfor %#
extraArgs:
  # https://kubernetes.io/docs/tasks/extend-kubernetes/configure-aggregation-layer/
  enable-aggregator-routing: true
  default-watch-cache-size: 50
---
apiVersion: v1alpha1
kind: KubeControllerManagerConfig
extraArgs:
  bind-address: 0.0.0.0
---
apiVersion: v1alpha1
kind: KubeSchedulerConfig
extraArgs:
  bind-address: 0.0.0.0
---
# Cilium replaces kube-proxy (kubeProxyReplacement), so it stays off.
apiVersion: v1alpha1
kind: KubeProxyConfig
enabled: false
---
# The cluster has never enforced Pod Security admission (the old
# `admissionControl: $$patch: delete`); the 1.14 generator emits a PodSecurity
# baseline-enforce document by default, so drop it to keep that behaviour.
apiVersion: v1alpha1
kind: KubeAdmissionControlConfig
name: PodSecurity
$$patch: delete
